@model Yarito.Endpoint.WebApp.MVC.Areas.Customer.Models.ChangePasswordViewModel
@{
    Layout = "_Layout";
}
<div class="edit-container edit-container--wide">
    <form action="#" method="post">
        @Html.AntiForgeryToken()
        <div class="card edit-card">
            <h2 class="edit-card__title">تغییر رمز عبور</h2>

            <div class="form-group">
                <label asp-for="OldPassword">رمز عبور فعلی</label>
                <input type="password" asp-for="OldPassword" placeholder="رمز عبور فعلی خود را وارد کنید" required>
                <span asp-validation-for="OldPassword" class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="NewPassword">رمز عبور جدید</label>
                <input type="password" asp-for="NewPassword" placeholder="رمز عبور جدید خود را وارد کنید" required>
                <span asp-validation-for="NewPassword" class="validation-error"></span>
                <p class="form-help">حداقل ۸ کاراکتر شامل حروف و اعداد</p>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmNewPassword">تکرار رمز عبور جدید</label>
                <input type="password" asp-for="ConfirmNewPassword" placeholder="تکرار رمز عبور جدید" required>
                <span asp-validation-for="ConfirmNewPassword" class="validation-error"></span>
            </div>
        </div>

        <!-- Footer Actions -->
        <div class="edit-actions edit-actions--center">
            <button type="submit" class="btn btn--primary">تغییر رمز عبور</button>
            <a asp-area="Customer"
               asp-controller="Dashboard"
               asp-action="Index"
               class="btn btn--secondary">انصراف</a>
        </div>
    </form>
</div>