@model Yarito.Endpoint.WebApp.MVC.Areas.Customer.Models.NewRequestViewModel
@{
    Layout = "_Layout";

    var selectedCategoryId = 0;
    Yarito.Domain.Core.DTOs.Works.CategoryFullDto? selectedCategory = null;
    var categoryWorksData = new System.Collections.Generic.List<object>();
    if (Model?.CategoryList != null && Model.WorkId > 0)
    {
        foreach (var category in Model.CategoryList)
        {
            if (category is null)
            {
                continue;
            }

            foreach (var work in category.Works)
            {
                if (work.Id == Model.WorkId)
                {
                    selectedCategoryId = category.Id;
                    selectedCategory = category;
                    break;
                }
            }

            if (selectedCategory != null)
            {
                break;
            }
        }
    }

    if (Model?.CategoryList != null)
    {
        foreach (var category in Model.CategoryList)
        {
            if (category is null)
            {
                continue;
            }

            var worksData = new System.Collections.Generic.List<object>();
            foreach (var work in category.Works)
            {
                worksData.Add(new { id = work.Id, title = work.Title, basePrice = work.BasePrice });
            }

            categoryWorksData.Add(new { id = category.Id, works = worksData });
        }
    }

    var categoryWorksJson = System.Text.Json.JsonSerializer.Serialize(categoryWorksData);
}

<div class="request-wizard">
<!-- Wizard Header -->
<div class="wizard-header">
    <div class="wizard-header__icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="12" y1="18" x2="12" y2="12"></line>
            <line x1="9" y1="15" x2="15" y2="15"></line>
        </svg>
    </div>
    <div class="wizard-header__content">
        <h1 class="wizard-header__title">ثبت درخواست جدید</h1>
        <p class="wizard-header__desc">درخواست خود را ثبت کنید تا متخصصان پیشنهادات خود را ارسال کنند</p>
    </div>
</div>

<!-- Wizard Body -->
<div class="wizard-body">
<form asp-area="Customer"
      asp-controller="Requests"
      asp-action="New"
      method="post"
      enctype="multipart/form-data"
      class="wizard-form">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="validation-error"></div>
<!-- Section: Basic Info -->
<div class="form-section">
    <div class="form-section__header">
        <div class="form-section__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="16" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
        </div>
        <div>
            <h3 class="form-section__title">اطلاعات اولیه</h3>
            <p class="form-section__desc">عنوان و توضیحات درخواست خود را وارد کنید</p>
        </div>
    </div>

    <div class="form-section__body">
        <!-- Title -->
        <div class="form-field">
            <label class="form-field__label" for="request-title">
                عنوان درخواست
                <span class="form-field__required">*</span>
            </label>
            <div class="form-field__input-wrapper">
                <input asp-for="Title" type="text" id="request-title" class="form-field__input"
                       placeholder="مثال: تعمیر شیر آب آشپزخانه" required>
                <span class="form-field__icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                    </svg>
                </span>
            </div>
            <span class="form-field__hint">عنوان کوتاه و گویا برای درخواست خود وارد کنید</span>
            <span asp-validation-for="Title" class="validation-error"></span>
        </div>

        <!-- Description -->
        <div class="form-field">
            <label class="form-field__label" for="request-description">
                توضیحات درخواست
                <span class="form-field__optional">(اختیاری)</span>
            </label>
            <textarea asp-for="Description" id="request-description" class="form-field__textarea" rows="4"
                                  placeholder="توضیحات کامل درخواست خود را بنویسید. هرچه جزئیات بیشتری ارائه دهید، پیشنهادات دقیق‌تری دریافت می‌کنید..."></textarea>
            <div class="form-field__footer">
                <span class="form-field__hint">حداقل ۲۰ کاراکتر</span>
                <span class="form-field__counter">۰ / ۵۰۰</span>
            </div>
            <span asp-validation-for="Description" class="validation-error"></span>
        </div>
    </div>
</div>

<!-- Section: Category -->
<div class="form-section">
    <div class="form-section__header">
        <div class="form-section__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                <polyline points="2 17 12 22 22 17"></polyline>
                <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
        </div>
        <div>
            <h3 class="form-section__title">دسته‌بندی و سرویس</h3>
            <p class="form-section__desc">نوع خدمات مورد نیاز خود را انتخاب کنید</p>
        </div>
    </div>

    <div class="form-section__body">
        <div class="form-field__row">
            <!-- Category Selection -->
            <div class="form-field">
                <label class="form-field__label" for="request-category">
                    دسته‌بندی
                    <span class="form-field__required">*</span>
                </label>
                <div class="form-field__select-wrapper">
                    <select id="request-category" class="form-field__select" data-placeholder="انتخاب دسته‌بندی..." required>
                        <option value="">انتخاب دسته‌بندی...</option>
                        @if (Model.CategoryList != null)
                        {
                            foreach (var category in Model.CategoryList)
                            {
                                if (category is null)
                                {
                                    continue;
                                }

                                var defaultPrice = 0m;
                                var hasPrice = false;
                                foreach (var work in category.Works)
                                {
                                    if (!hasPrice || work.BasePrice < defaultPrice)
                                    {
                                        defaultPrice = work.BasePrice;
                                        hasPrice = true;
                                    }
                                }

                                var defaultPriceValue = hasPrice
                                    ? defaultPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)
                                    : "";
                                <option value="@category.Id"
                                        data-default-price="@defaultPriceValue"
                                        data-works="@System.Text.Json.JsonSerializer.Serialize(category.Works)"
                                        selected="@(selectedCategoryId == category.Id)">
                                    @category.CategoryTitle
                                </option>
                            }
                        }
                    </select>
                    <span class="form-field__select-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </span>
                </div>
            </div>

            <!-- Service Selection -->
            <div class="form-field">
                <label class="form-field__label" for="request-service">
                    نوع سرویس
                    <span class="form-field__required">*</span>
                </label>
                <div class="form-field__select-wrapper">
                    <select id="request-service"
                            asp-for="WorkId"
                            class="form-field__select"
                            data-placeholder="انتخاب سرویس..."
                            data-placeholder-empty="ابتدا دسته‌بندی را انتخاب کنید..."
                            data-selected-work="@Model.WorkId"
                            required>
                        <option value="">ابتدا دسته‌بندی را انتخاب کنید...</option>
                        @if (selectedCategory != null)
                        {
                            foreach (var work in selectedCategory.Works)
                            {
                                <option value="@work.Id"
                                        data-base-price="@work.BasePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                        selected="@(Model.WorkId == work.Id)">
                                    @work.Title
                                </option>
                            }
                        }
                    </select>
                    <span class="form-field__select-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </span>
                </div>
                <span class="form-field__hint">پس از انتخاب دسته‌بندی، سرویس‌های مرتبط نمایش داده می‌شوند</span>
                <span asp-validation-for="WorkId" class="validation-error"></span>
            </div>
        </div>
    </div>
</div>

<!-- Section: Location -->
<script type="application/json" id="categoryWorksData">
@Html.Raw(categoryWorksJson)
</script>
<div class="form-section">
    <div class="form-section__header">
        <div class="form-section__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
            </svg>
        </div>
        <div>
            <h3 class="form-section__title">آدرس محل انجام کار</h3>
            <p class="form-section__desc">آدرس دقیق محل مورد نظر را وارد کنید</p>
        </div>
    </div>

    <div class="form-section__body">
        <div class="form-field">
            <label class="form-field__label" for="use-profile-address">
                <input asp-for="UseProfileAddress" type="checkbox" id="use-profile-address" class="form-field__checkbox">
                استفاده از آدرس پروفایل
                <span class="form-field__required"></span>
            </label>
        </div>

        <!-- Address -->
        <div class="form-field">
            <label class="form-field__label" for="request-address">
                آدرس کامل
                <span class="form-field__required">*</span>
            </label>
            <div class="form-field__input-wrapper form-field__input-wrapper--textarea">
                <textarea asp-for="Address" id="request-address" class="form-field__textarea" rows="3"
                                      placeholder="منطقه، خیابان، کوچه، پلاک و واحد..." required></textarea>
                <span class="form-field__icon form-field__icon--textarea">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                </span>
            </div>
            <span asp-validation-for="Address" class="validation-error"></span>
        </div>
    </div>
</div>

<!-- Section: Details -->
<div class="form-section">
    <div class="form-section__header">
        <div class="form-section__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
        </div>
        <div>
            <h3 class="form-section__title">جزئیات اختیاری</h3>
            <p class="form-section__desc">اطلاعات تکمیلی برای دریافت پیشنهادات بهتر</p>
        </div>
    </div>

    <div class="form-section__body">
        <div class="form-field__row">
            <!-- Suggested Price -->
            <div class="form-field">
                <label class="form-field__label" for="request-price">
                    قیمت پیشنهادی شما
                    <span class="form-field__optional">(اختیاری)</span>
                </label>
                <div class="form-field__input-wrapper form-field__input-wrapper--price">
                    <input asp-for="ProposedPrice" type="text" id="request-price"
                           class="form-field__input form-field__input--ltr form-field__input--price" placeholder="۵۰۰,۰۰۰">
                    <span class="form-field__suffix">تومان</span>
                </div>
                <span class="form-field__hint form-field__hint--price">
                    قیمت پیش‌فرض سرویس: <strong id="defaultServicePrice">—</strong>
                </span>
                <span asp-validation-for="ProposedPrice" class="validation-error"></span>
            </div>

            <!-- Suggested Date -->
            <div class="form-field">
                <label class="form-field__label" for="request-date">
                    تاریخ مراجعه
                    <span class="form-field__optional">(اختیاری)</span>
                </label>
                <div class="form-field__input-wrapper">
                    <input id="visitFa" type="text" data-jdp class="form-field__input form-field__input--ltr" autocomplete="off" placeholder="۱۴۰۴/۱۰/۱۵">
                    <input type="hidden" id="VisitDateTime" asp-for="PreferredVisitDateTime">
                    <span class="form-field__icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                    </span>
                </div>
                <span class="form-field__hint">تاریخ مورد نظر شما برای انجام کار</span>
            </div>
        </div>
    </div>
</div>

<!-- Section: Images -->
<div class="form-section">
    <div class="form-section__header">
        <div class="form-section__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                <polyline points="21 15 16 10 5 21"></polyline>
            </svg>
        </div>
        <div>
            <h3 class="form-section__title">تصاویر مرتبط</h3>
            <p class="form-section__desc">تصاویر مشکل یا محل کار را آپلود کنید (اختیاری)</p>
        </div>
    </div>

    <div class="form-section__body">
        <!-- Upload Zone -->
        <div class="upload-zone" id="uploadZone">
            <div class="upload-zone__content">
                <div class="upload-zone__icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="17 8 12 3 7 8"></polyline>
                        <line x1="12" y1="3" x2="12" y2="15"></line>
                    </svg>
                </div>
                <div class="upload-zone__text">
                    <p class="upload-zone__title">تصاویر را اینجا رها کنید</p>
                    <p class="upload-zone__subtitle">
                        یا <span class="upload-zone__link">کلیک کنید</span> برای انتخاب
                    </p>
                </div>
                <div class="upload-zone__info">
                    <span>حداکثر ۴ تصویر</span>
                    <span>•</span>
                    <span>JPG, PNG, WebP</span>
                    <span>•</span>
                    <span>حداکثر ۵ مگابایت</span>
                </div>
            </div>
            <input asp-for="RequestImg" type="file" id="imageUpload" class="upload-zone__input" accept="image/*" multiple>
        </div>

        <!-- Image Previews -->
        <div class="upload-previews" id="uploadPreviews"></div>
        <span asp-validation-for="RequestImg" class="validation-error"></span>
    </div>
</div>

<!-- Form Actions -->
<div class="wizard-footer">
    <a href="user-profile.html" class="btn btn--ghost btn--lg">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
        انصراف
    </a>
    <button type="submit" class="btn btn--primary btn--lg">
        ثبت درخواست
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
    </button>
</div>
</form>
</div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/JalaliDateInput.js"></script>
    <script src="~/js/new-request-category-service.js" asp-append-version="true"></script>
    <script src="~/js/new-request-images.js" asp-append-version="true"></script>
    <script src="~/js/new-request-price.js" asp-append-version="true"></script>
    <script src="~/js/use-profile-address.js"></script>
}
