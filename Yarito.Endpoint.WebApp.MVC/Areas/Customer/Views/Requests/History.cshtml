@using Yarito.Domain.Core.Enums.Requests
@using Yarito.Endpoint.WebApp.MVC.Areas.Customer.Models
@model Yarito.Endpoint.WebApp.MVC.Areas.Customer.Models.HistoryViewModel
@{
    Layout = "_Layout";
}
<section class="profile-main">

    <!-- Page Header -->
    <div class="user-page-header">
        <h2>تاریخچه درخواست‌ها</h2>
    </div>

    <!-- Filter Section -->
    <div class="card user-section mb-lg">
        <form asp-area="Customer"
              asp-controller="Requests"
              asp-action="History"
              class="requests-filter-bar"
              method="get">
            <div class="filter-item filter-item--search">
                <input type="text" asp-for="Search" class="form-control" placeholder="جستجو ...">
            </div>

            <div class="filter-item filter-item--select">
                <select asp-for="Status" class="form-control">
                    <option value="">همه</option>
                    <option value="@RequestStatusEnum.Pending" selected="@(Model.Status == RequestStatusEnum.Pending)">دریافت پیشنهاد</option>
                    <option value="@RequestStatusEnum.InProgress" selected="@(Model.Status == RequestStatusEnum.InProgress)">در انتظار انجام</option>
                    <option value="@RequestStatusEnum.Completed" selected="@(Model.Status == RequestStatusEnum.Completed)">تکمیل شده</option>
                    <option value="@RequestStatusEnum.Cancelled" selected="@(Model.Status == RequestStatusEnum.Cancelled)">لغو شده</option>
                </select>
            </div>

            <div class="filter-item filter-item--action">
                <button type="submit" class="btn btn--secondary btn--block">فیلتر</button>
            </div>
        </form>
    </div>

    <!-- Requests List -->
    <div class="card dashboard-card">
        <div class="requests-table-wrapper">
            <table class="requests-table">
                <thead>
                    <tr>
                        <th>کد درخواست</th>
                        <th>عنوان</th>
                        <th>سرویس</th>
                        <th>تاریخ ثبت</th>
                        <th>وضعیت</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var r in Model.Requests)
                {
                        <tr>
                            <td><a href="#">#@r.Id.ToString().ToPersianNum()</a></td>
                            <td>@r.Title</td>
                            <td>@r.WorkTitle</td>
                            <td>@r.CreateAt.CompleteShamsiDate("yyyy/mm/dd")</td>
                            <td>
                                <span class="badge @(r.Status switch
                                      {
                                          RequestStatusEnum.Pending    => "badge--receiving",
                                          RequestStatusEnum.Completed  => "badge--completed",
                                          RequestStatusEnum.Cancelled  => "badge--cancelled",
                                          RequestStatusEnum.InProgress => "badge--waiting",
                                          _                            => ""
                                      })">@Html.DisplayFor(_ => r.Status)</span>
                            </td>
                            <td>
                                <a asp-area="Customer"
                                   asp-controller="Requests"
                                   asp-action="Details"
                                   asp-route-id="@r.Id"
                                   class="btn btn--ghost btn--sm">مشاهده جزئیات</a>
                            </td>
                        </tr>
                }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @await Html.PartialAsync("_Pagination", new PaginationViewModel
        {
            Page = Model.Page,
            TotalPages = Model.TotalPages,
            Area = "Customer",
            Controller = "Requests",
            Action = "Details",
            RouteValues = new Dictionary<string, string?>
            {
                ["search"] = Model.Search,
                ["status"] = Model.Status.ToString(),
            }
        })
    </div>
</section>