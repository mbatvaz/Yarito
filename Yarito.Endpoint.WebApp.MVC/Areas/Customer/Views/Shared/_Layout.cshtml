@using System.Security.Claims
@using Yarito.Framework
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>پروفایل کاربری | یاریتو</title>
    <meta name="description" content="پروفایل کاربری یاریتو - مشاهده و مدیریت اطلاعات حساب کاربری">

    <link rel="stylesheet" href="~/css/user.css">

    @* <link rel="stylesheet" href="~/css/persian-datepicker.min.css"> *@
    <link rel="stylesheet" href="~/css/jalalidatepicker.min.css">


    <link href="~/css/select2.min.css" rel="stylesheet" />
    @* <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" /> *@
    @* <link href="https://lib.arvancloud.ir/select2/4.1.0-rc.0/css/select2.min.css" rel="stylesheet" /> *@
    
    <link href="~/css/glightbox.min.css" rel="stylesheet" />
    @* <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox@3.3.0/dist/css/glightbox.min.css" /> *@
    @* <link rel="stylesheet" href="https://lib.arvancloud.ir/glightbox/3.2.0/css/glightbox.min.css" /> *@
</head>

<body class="theme-user">
<partial name="_Notifications" />
<div class="page-with-sidebar">
    <!-- Sidebar Navigation -->
    <aside class="user-sidebar">
        <div class="user-sidebar__header">
            <img class="user-sidebar__avatar" src="@User.FindFirstValue("ProfileImage")" alt="تصویر پروفایل">
            <div class="user-sidebar__user-info">
                <h3 class="user-sidebar__name">@User.FindFirstValue("FullName")</h3>
            </div>
        </div>

        <nav class="user-sidebar__nav">
            <ul class="user-sidebar__nav-list">
                <li>
                    <a asp-area="Customer"
                       asp-controller="Dashboard"
                       asp-action="Index"
                       class="user-sidebar__nav-item @(action == "Index" ? "user-sidebar__nav-item--active" : "") ">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                            <polyline points="9 22 9 12 15 12 15 22"></polyline>
                        </svg>
                        داشبورد
                    </a>
                </li>
                <li>
                    <a asp-area="Customer"
                       asp-controller="Dashboard"
                       asp-action="CustomerForm"
                       class="user-sidebar__nav-item @(action == "CustomerForm" ? "user-sidebar__nav-item--active" : "")">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                        ویرایش پروفایل
                    </a>
                </li>

                <div class="user-sidebar__divider"></div>
                <span class="user-sidebar__nav-label">درخواست‌ها</span>

                <li>
                    <a asp-area="Customer"
                       asp-controller="CustomerRequest"
                       asp-action="NewRequest"
                       class="user-sidebar__nav-item @(controller == "CustomerRequest" ? "user-sidebar__nav-item--active" : "")">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        ثبت درخواست جدید
                    </a>
                </li>
                <li>
                    <a href="#" class="user-sidebar__nav-item @(controller == "" ? "user-sidebar__nav-item--active" : "")">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                        </svg>
                        درخواست‌های من
                    </a>
                </li>

                <div class="user-sidebar__divider"></div>
                <span class="user-sidebar__nav-label">مالی</span>

                <li>
                    <a href="#" class="user-sidebar__nav-item @(controller == "" ? "user-sidebar__nav-item--active" : "")">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                            <line x1="1" y1="10" x2="23" y2="10"></line>
                        </svg>
                        کیف پول
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Date Time Box -->
        <div class="sidebar-datetime">
            <div class="sidebar-datetime__date">@(DateTime.UtcNow.CompleteShamsiDate("dn, dd mn yyyy"))</div>
            <span class="sidebar-datetime__time" id="liveClock"></span>
        </div>

        <div class="user-sidebar__footer">
            <a asp-area="Account"
               asp-controller="Authentication"
               asp-action="Logout"
               class="user-sidebar__logout">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
                خروج از حساب
            </a>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="page-content">
        @RenderBody()
    </main>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
@* <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script> *@
@* <script src="https://lib.arvancloud.ir/jquery/3.6.3/jquery.min.js"></script> *@

<script src="~/js/select2.min.js"></script>
@* <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script> *@
@* <script src="https://lib.arvancloud.ir/select2/4.1.0-rc.0/js/select2.min.js"></script> *@

<script src="~/js/fa.js"></script>
@* <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/i18n/fa.js"></script> *@
@* <script src="https://lib.arvancloud.ir/select2/4.1.0-rc.0/js/i18n/fa.min.js"></script> *@

<script src="~/js/glightbox.min.js"></script>
@* <script src="https://cdn.jsdelivr.net/npm/glightbox@3.3.0/dist/js/glightbox.min.js"></script> *@
@* <script src="https://lib.arvancloud.ir/glightbox/3.2.0/js/glightbox.min.js"></script> *@

<script src="~/js/time.js"></script>

<script src="~/js/jalalidatepicker.min.js"></script>
<script src="~/js/jalali-moment.browser.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
