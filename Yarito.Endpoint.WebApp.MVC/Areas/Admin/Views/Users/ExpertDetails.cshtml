@using Yarito.Domain.Core.Enums.Requests
@using Yarito.Endpoint.WebApp.MVC.Areas.Admin.Models
@model Yarito.Endpoint.WebApp.MVC.Areas.Admin.Models.ExpertDetailsViewModel
@{
    Layout = "_Layout";
}
<!-- Page Header -->
<div class="admin-page-header">
    <h2>جزئیات متخصص</h2>
    <a asp-area="Admin"
       asp-controller="Users"
       asp-action="Index"
       class="btn btn--ghost">بازگشت</a>
</div>

<!-- Expert Info & Services Side by Side -->
<div class="admin-offer-users-grid">
    <!-- Expert Info Box -->
    <section class="card admin-box admin-customer-info-box">
        @await Html.PartialAsync("_UserDetailsPartial", new UserDetailsViewModel()
        { 
            Id = Model.UserDetails.Id,
            ProfileImgPath = Model.UserDetails.ProfileImgPath,
            FirstName = Model.UserDetails.FirstName,
            LastName = Model.UserDetails.LastName,
            UserType = Model.UserDetails.UserType,
            CreatedAt = Model.UserDetails.CreatedAt,
            PhoneNumber = Model.UserDetails.PhoneNumber,
            CityName = Model.UserDetails.CityName,
            Email = Model.UserDetails.Email,
            WalletBalance = Model.UserDetails.WalletBalance,
            Address = Model.UserDetails.Address
        })
    </section>

    <!-- Services by Category -->
    <section class="card admin-box admin-expert-services-box">
        <div class="admin-box__header">
            <h3>خدمات ارائه شده</h3>
        </div>
        @if (Model.ExpertWorks.Count > 0)
        {
            <div class="admin-expert-services">
                @foreach (var c in Model.ExpertWorks)
                {
                    <div class="admin-expert-services__category">
                        <h4>@c.CategoryTitle</h4>
                        <div class="admin-services-badges">
                            @foreach (var w in c.Works)
                            {
                                <span class="badge">@w.Title</span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="admin-empty-state">
                <p>هیچ خدماتی ثبت نشده است.</p>
            </div>
        }
    </section>
</div>

<!-- Expert Offers -->
<section class="card admin-box">
    <div class="admin-box__header">
        <h3>لیست پیشنهادات</h3>
        <div class="admin-box__search">
            <form asp-area="Admin"
                  asp-controller="Users"
                  asp-action="ExpertDetails"
                  method="get">
                <input type="hidden" asp-for="ExpertId" />
                <input asp-for="Search" type="text" placeholder="جستجو..." class="admin-search-input">
                <button type="submit" class="btn btn--primary btn--sm">جستجو</button>
            </form>
        </div>
    </div>
    
    @if (Model.Bids.Count > 0)
    {
        <div class="admin-table-wrapper">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>کد پیشنهاد</th>
                        <th>سرویس</th>
                        <th>قیمت</th>
                        <th>تاریخ</th>
                        <th>وضعیت</th>
                        <th class="text-left">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var b in Model.Bids)
                {
                    <tr>
                        <td><a href="#">#@b.Id.ToString().ToPersianNum()</a></td>
                        <td>@b.ServiceTitle</td>
                        <td>@b.ProposedPrice.ToString("N0").ToPersianNum() تومان</td>
                        <td>@b.ProposedVisitDate.CompleteShamsiDate("yyyy/mm/dd")</td>
                        <td><span class="badge @(b.Status switch
                                               {
                                                   BidStatusEnum.Pending  => "badge--waiting",
                                                   BidStatusEnum.Accepted => "badge--completed",
                                                   BidStatusEnum.Rejected => "badge--cancelled",
                                                   BidStatusEnum.Done     => "badge--completed",
                                                   _ => ""
                                               })">
                                @Html.DisplayFor(_ => b.Status)
                            </span></td>
                        <td class="text-left">
                            <a asp-area="Admin"
                               asp-controller="Requests"
                               asp-action="BidDetails"
                               asp-route-id="@b.Id"
                               class="btn btn--ghost btn--sm">مشاهده</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @await Html.PartialAsync("_Pagination", new PaginationViewModel()
        {
            Page = Model.Page,
            TotalPages = Model.TotalPages,
            Area = "Admin",
            Controller = "Users",
            Action = "ExpertDetails",
            RouteValues = new Dictionary<string, string?>
            {
                ["search"] = Model.Search ?? "",
                ["id"] = Model.ExpertId.ToString()
            }
        })
    }
    else
    {
        <div class="admin-empty-state">
            <p>هیچ پیشنهادی یافت نشد.</p>
        </div>
    }
</section>