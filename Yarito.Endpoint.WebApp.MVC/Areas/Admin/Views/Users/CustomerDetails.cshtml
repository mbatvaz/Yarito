@using Yarito.Domain.Core.Enums.Requests
@using Yarito.Endpoint.WebApp.MVC.Areas.Admin.Models
@model Yarito.Endpoint.WebApp.MVC.Areas.Admin.Models.CustomerDetailsViewModel
@{
    Layout = "_Layout";
}
<!-- Page Header -->
<div class="admin-page-header">
    <h2>جزئیات مشتری</h2>
    <a asp-area="Admin"
       asp-controller="Users"
       asp-action="Index"
       class="btn btn--ghost">بازگشت</a>
</div>

<!-- Customer Info Box -->
<div class="admin-customer-info-wrapper">
    <section class="card admin-box admin-customer-info-box">
        @await Html.PartialAsync("_UserDetailsPartial", new UserDetailsViewModel()
        { 
            Id = Model.UserDetails.Id,
            ProfileImgPath = Model.UserDetails.ProfileImgPath,
            FirstName = Model.UserDetails.FirstName,
            LastName = Model.UserDetails.LastName,
            UserType = Model.UserDetails.UserType,
            CreatedAt = Model.UserDetails.CreatedAt,
            PhoneNumber = Model.UserDetails.PhoneNumber,
            CityName = Model.UserDetails.CityName,
            Email = Model.UserDetails.Email,
            WalletBalance = Model.UserDetails.WalletBalance,
            Address = Model.UserDetails.Address
        })
    </section>
</div>

<!-- Customer Requests -->
<section class="card admin-box">
    <div class="admin-box__header">
        <h3>لیست درخواست‌ها</h3>
        <div class="admin-box__search">
            <form asp-area="Admin"
                  asp-controller="Users"
                  asp-action="CustomerDetails"
                  method="get">
                <input type="hidden" asp-for="CustomerId" />
                <input asp-for="Search" type="text" placeholder="جستجو..." class="admin-search-input">
                <button type="submit" class="btn btn--primary btn--sm">جستجو</button>
            </form>
        </div>
    </div>
    
    @if (Model.Requests.Count > 0)
    {
        <div class="admin-table-wrapper">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>کد درخواست</th>
                        <th>عنوان درخواست</th>
                        <th>سرویس</th>
                        <th>تاریخ</th>
                        <th>وضعیت</th>
                        <th class="text-left">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var r in Model.Requests)
                {
                    <tr>
                        <td><a href="#">#@r.Id.ToString().ToPersianNum()</a></td>
                        <td>@r.Title</td>
                            <td>@r.WorkTitle</td>
                        <td>@r.CreateAt.CompleteShamsiDate("yyyy/mm/dd")</td>
                        <td><span class="badge
                                @(r.Status switch
                                  {
                                      RequestStatusEnum.Pending => "badge--receiving",
                                      RequestStatusEnum.Completed => "badge--completed",
                                      RequestStatusEnum.Cancelled => "badge--cancelled",
                                      RequestStatusEnum.InProgress => "badge--waiting",
                                      _ => ""
                                  })">@Html.DisplayFor(_ => r.Status)</span>
                        </td>
                        <td class="text-left">
                            <a asp-area="Admin"
                               asp-controller="Requests"
                               asp-action="RequestDetails"
                               asp-route-id="@r.Id"
                               class="btn btn--ghost btn--sm">مشاهده</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @await Html.PartialAsync("_Pagination", new PaginationViewModel()
        {
            Page = Model.Page,
            TotalPages = Model.TotalPages,
            Area = "Admin",
            Controller = "Users",
            Action = "CustomerDetails",
            RouteValues = new Dictionary<string, string?>
            {
                ["search"] = Model.Search ?? "",
                ["id"] = Model.CustomerId.ToString()
            }
        })
    }
    else
    {
        <div class="admin-empty-state">
            <p>هیچ درخواستی یافت نشد.</p>
        </div>
    }
</section>
