@using Yarito.Domain.Core.Enums.Requests
@using Yarito.Endpoint.WebApp.MVC.Areas.Admin.Models
@model Yarito.Endpoint.WebApp.MVC.Areas.Admin.Models.BidDetailsViewModel

@{
    Layout = "_Layout";
}
<!-- Page Header -->
<div class="admin-page-header">
    <h2>جزئیات پیشنهاد</h2>
    <button type="button" class="btn btn--ghost" onclick="history.back()">بازگشت</button>
</div>

<!-- Customer & Expert Info Boxes Side by Side -->
<div class="admin-offer-users-grid">
    <!-- Customer Info Box -->
    <section class="card admin-box admin-customer-info-box">
        <a asp-area="Admin"
           asp-controller="Users"
           asp-action="CustomerDetails"
           asp-route-id="@Model.Customer.Id"
           class="btn btn--ghost btn--sm"
           style="position: absolute; top: 16px; left: 16px;">مشاهده</a>
        @await Html.PartialAsync("_UserDetailsPartial", new UserDetailsViewModel()
        {
            Id = Model.Customer.Id,
                ProfileImgPath = Model.Customer.ProfileImgPath,
                FirstName = Model.Customer.FirstName,
                LastName = Model.Customer.LastName,
                UserType = Model.Customer.UserType,
                CreatedAt = Model.Customer.CreatedAt,
                PhoneNumber = Model.Customer.PhoneNumber,
                CityName = Model.Customer.CityName,
                Email = Model.Customer.Email,
                WalletBalance = Model.Customer.WalletBalance,
                Address = Model.Customer.Address
        })
    </section>

    <!-- Expert Info Box -->
    <section class="card admin-box admin-customer-info-box">
        <a asp-area="Admin"
           asp-controller="Users"
           asp-action="ExpertDetails"
           asp-route-id="@Model.Expert.Id"
           class="btn btn--ghost btn--sm" style="position: absolute; top: 16px; left: 16px;">مشاهده</a>
        @await Html.PartialAsync("_UserDetailsPartial", new UserDetailsViewModel()
        {
            Id = Model.Expert.Id,
            ProfileImgPath = Model.Expert.ProfileImgPath,
            FirstName = Model.Expert.FirstName,
            LastName = Model.Expert.LastName,
            UserType = Model.Expert.UserType,
            CreatedAt = Model.Expert.CreatedAt,
            PhoneNumber = Model.Expert.PhoneNumber,
            CityName = Model.Expert.CityName,
            Email = Model.Expert.Email,
            WalletBalance = Model.Expert.WalletBalance,
            Address = Model.Expert.Address
        })
    </section>
</div>

<!-- Request & Offer Info Boxes Side by Side -->
<div class="admin-offer-users-grid">
    <!-- Request Info Box (Right) with 8.png background -->
    <section class="card admin-box admin-request-info-box">
        @await Html.PartialAsync("_RequestDetailsPartial", new RequestDetailsPartialViewModel()
        {
            Id = Model.Request.Id,
            Status = Model.Request.Status,
            Address = Model.Request.Address,
            Title = Model.Request.Title,
            CreatedAt = Model.Request.CreatedAt,
            Description = Model.Request.Description,
            PreferredVisitDateTime = Model.Request.PreferredVisitDateTime,
            ProposedPrice = Model.Request.ProposedPrice
        })
    </section>

    <!-- Offer Info Box (Left) with 9.png background -->
    <section class="card admin-box admin-proposal-info-box">
        <div class="admin-box__header">
            <h3>اطلاعات پیشنهاد</h3>
            <span class="badge @(Model.Bid.Status switch
                                                  {
                                                      BidStatusEnum.Accepted => "badge--completed",
                                                      BidStatusEnum.Rejected => "badge--cancelled",
                                                      _ => "badge--waiting" })">@Html.DisplayFor(_ => Model.Bid.Status)</span>
        </div>
        <div class="admin-info-columns">
            <div class="admin-info-columns__right">
                <dl class="admin-details-list admin-details-list--vertical">
                    <div class="admin-details-list__item">
                        <dt>تاریخ ثبت</dt>
                        <dd>@Model.Bid.CreatedAt.CompleteShamsiDate("dn, dd mn yyyy - HH:MM")</dd>
                    </div>
                </dl>
            </div>
            <div class="admin-info-columns__left">
                <dl class="admin-details-list admin-details-list--vertical">
                    <div class="admin-details-list__item">
                        <dt>تاریخ مراجعه پیشنهادی</dt>
                        <dd>@Model.Bid.ProposedVisitDateTime.CompleteShamsiDate("dn, dd mn yyyy"))</dd>
                    </div>
                </dl>
            </div>
        </div>
        <dl class="admin-details-list admin-details-list--vertical">
            <div class="admin-details-list__item">
                <dt>قیمت پیشنهادی</dt>
                <dd><strong style="color: var(--color-primary);">@Model.Bid.ProposedPrice.ToString("N0").ToPersianNum() تومان</strong></dd>
            </div>
            <div class="admin-details-list__item">
                <dt>توضیحات پیشنهاد</dt>
                <dd>@Model.Bid.Description</dd>
            </div>
        </dl>
    </section>
</div>