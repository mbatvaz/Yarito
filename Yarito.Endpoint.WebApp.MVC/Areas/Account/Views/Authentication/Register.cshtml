@{
    Layout = "_Layout";
}
<form id="register-form" class="auth__form auth__form--wide" action="#" method="post">
    <div class="auth__form-header">
        <p>برای شروع، اطلاعات خود را وارد کنید.</p>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="firstName">نام</label>
            <input type="text"
                   id="firstName"
                   name="firstName"
                   placeholder="نام خود را وارد کنید"
                   autocomplete="given-name"
                   required>
        </div>

        <div class="form-group">
            <label for="lastName">نام خانوادگی</label>
            <input type="text"
                   id="lastName"
                   name="lastName"
                   placeholder="نام خانوادگی خود را وارد کنید"
                   autocomplete="family-name"
                   required>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="phone">شماره موبایل</label>
            <input type="tel"
                   id="phone"
                   name="phone"
                   dir="ltr"
                   inputmode="numeric"
                   placeholder="09xxxxxxxxx"
                   autocomplete="tel"
                   required>
        </div>

        <div class="form-group">
            <label for="password">رمز عبور</label>
            <input type="password"
                   id="password"
                   name="password"
                   placeholder="یک رمز عبور امن انتخاب کنید"
                   autocomplete="new-password"
                   required>
        </div>
    </div>

    <fieldset class="form-group form-group--radio form-group--radio-inline">
        <legend style="font-size: 0.875rem; font-weight: 500; margin-bottom: 8px;">نوع کاربری را انتخاب کنید:</legend>

        <label class="radio-option radio-option--simple">
            <input type="radio"
                   name="userType"
                   value="customer"
                   required>
            <div class="radio-option__content">
                <div class="radio-option__title">مشتری</div>
                <div class="radio-option__desc">درخواست ثبت می‌کند و از خدمات متخصصان استفاده می‌کند.</div>
            </div>
        </label>

        <label class="radio-option radio-option--simple">
            <input type="radio"
                   name="userType"
                   value="expert">
            <div class="radio-option__content">
                <div class="radio-option__title">متخصص</div>
                <div class="radio-option__desc">خدمات ارائه می‌دهد و به درخواست‌های مشتریان پاسخ می‌دهد.</div>
            </div>
        </label>
    </fieldset>

    <button type="submit" class="btn btn--primary btn--block btn--lg">ثبت نام</button>

    <div class="auth__links">
        <p>حساب دارید؟ <a href="login.html">ورود</a></p>
    </div>
</form>