@using Yarito.Endpoint.WebApp.MVC.Areas.Expert.Models
@model Yarito.Endpoint.WebApp.MVC.Areas.Expert.Models.OpenRequestViewModel
@{
    Layout = "_Layout";
}
<section class="profile-main">

    <!-- Page Header -->
    <div class="user-page-header">
        <h2>درخواست‌های موجود</h2>
    </div>

    <!-- Filter Section - Improved Design -->
    <div class="card user-section filter-section">
        <div class="filter-section__header">
            <h3 class="filter-section__title">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                </svg>
                فیلتر درخواست‌ها
            </h3>
        </div>
        <form asp-area="Expert" asp-controller="Request" asp-action="Open" class="filter-form" method="get">
            <div class="filter-form__row">
                <div class="filter-form__field filter-form__field--wide">
                    <label asp-for="Search" class="filter-form__label">جستجو</label>
                    <input type="text" asp-for="Search" class="form-control" placeholder="عنوان درخواست را وارد کنید...">
                </div>
                <div class="filter-form__field">
                    <label asp-for="WorkId" class="filter-form__label">دسته‌بندی</label>

                    <select asp-for="WorkId" class="form-control"
                            asp-items="@(Model.ExpertWorks.Select(w => new SelectListItem
                                       {
                                           Value = w.Id.ToString(),
                                           Text  = w.Title
                                       }))">
                        <option value="">همه سرویس ها</option>
                    </select>
                </div>
                <div class="filter-form__actions">
                    <button type="submit" class="btn btn--primary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                        اعمال فیلتر
                    </button>
                    <button type="reset" class="btn btn--ghost">پاک کردن</button>
                </div>
            </div>
        </form>
    </div>

    <!-- Requests List -->
    <div class="card dashboard-card">
        <div class="dashboard-card__header">
            <h3 class="dashboard-card__title">درخواست‌های مرتبط با تخصص شما</h3>
            <span class="badge badge--info">@Model.TotalCount.ToString("N0").ToPersianNum() درخواست</span>
        </div>

        <div class="requests-grid">
            @foreach (var r in Model.OpenRequest)
            {
                <div class="request-card">
                    <div class="request-card__header">
                        <div class="request-card__service-badge">
                            @r.WorkTitle
                        </div>
                        <span class="request-card__date">@r.CreatedAt.CompleteShamsiDate("dd mn yyyy")</span>
                    </div>

                    <div class="request-card__body">
                        <h4 class="request-card__title">@r.Title.ToPersianNum()</h4>
                        <p class="request-card__desc">
                            @r.Description.ToPersianNum()
                        </p>
                        <div class="request-card__price">
                            <div class="request-card__suggested-date">
                                <span class="text-muted">تاریخ پیشنهادی:</span>
                                <span>
                                    @(r.PreferredVisitDateTime is null 
                                        ? "تاریخی اعلام نشده" 
                                        : r.PreferredVisitDateTime.Value.CompleteShamsiDate("dd mn yyyy"))
                                </span>
                            </div>
                            <span class="price-value">
                                @(r.ProposedPrice is null 
                                    ? "قیمتی اعلام نشده" 
                                    : r.ProposedPrice.Value.ToString("N0").ToPersianNum()+" تومان")
                            </span>
                        </div>
                    </div>
                    <div class="request-card__footer">

                        <a asp-area="Expert"
                           asp-controller="Request"
                           asp-action="Details"
                           asp-route-requestId="@r.RequestId"
                           class="btn btn--outline-primary btn--sm btn--block">
                            مشاهده جزئیات و ثبت پیشنهاد
                        </a>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @await Html.PartialAsync("_Pagination", new PaginationViewModel
        {
            Page = Model.Page,
            TotalPages = Model.TotalPages,
            Area = "Expert",
            Controller = "Request",
            Action = "Open",
            RouteValues = new Dictionary<string, string?>()
            {
                ["search"] = Model.Search,
                ["workId"] = Model.WorkId.ToString(),
            }
        })
    </div>
</section>