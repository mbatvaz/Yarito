@{
    Layout = "_Layout";
}
<section class="profile-main">

    <!-- Page Header -->
    <div class="user-page-header">
        <h2>درخواست‌های موجود</h2>
    </div>

    <!-- Filter Section - Improved Design -->
    <div class="card user-section filter-section">
        <div class="filter-section__header">
            <h3 class="filter-section__title">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                </svg>
                فیلتر درخواست‌ها
            </h3>
        </div>
        <form class="filter-form">
            <div class="filter-form__row">
                <div class="filter-form__field filter-form__field--wide">
                    <label for="search" class="filter-form__label">جستجو</label>
                    <input type="text" id="search" class="form-control" placeholder="عنوان درخواست را وارد کنید...">
                </div>
                <div class="filter-form__field">
                    <label for="category" class="filter-form__label">دسته‌بندی</label>
                    <select id="category" class="form-control">
                        <option value="">همه دسته‌بندی‌ها</option>
                        <option value="plumbing">لوله‌کشی</option>
                        <option value="electrical">برق‌کاری</option>
                        <option value="hvac">تهویه مطبوع</option>
                        <option value="appliance">تعمیر لوازم خانگی</option>
                    </select>
                </div>
                <div class="filter-form__actions">
                    <button type="submit" class="btn btn--primary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                        اعمال فیلتر
                    </button>
                    <button type="reset" class="btn btn--ghost">پاک کردن</button>
                </div>
            </div>
        </form>
    </div>

    <!-- Requests List -->
    <div class="card dashboard-card">
        <div class="dashboard-card__header">
            <h3 class="dashboard-card__title">درخواست‌های مرتبط با تخصص شما</h3>
            <span class="badge badge--info">۸ درخواست</span>
        </div>

        <div class="requests-grid">
            <!-- Request Card 1 -->
            <div class="request-card">
                <div class="request-card__header">
                    <div class="request-card__service-badge">
                        تهویه مطبوع
                    </div>
                    <span class="request-card__date">۱۴۰۴/۱۰/۰۹</span>
                </div>

                <div class="request-card__body">
                    <h4 class="request-card__title">تعمیر پکیج دیواری ایران رادیاتور</h4>
                    <p class="request-card__desc">
                        پکیج دیواری خطای E۱۰ می‌دهد و آب گرم نمی‌کند. نیاز به بررسی و تعمیر دارد.
                    </p>
                    <div class="request-card__price">
                        <div class="request-card__suggested-date">
                            <span class="text-muted">تاریخ پیشنهادی:</span>
                            <span>۱۴۰۴/۱۰/۱۲</span>
                        </div>
                        <span class="price-value">۵۰۰٬۰۰۰ تومان</span>
                    </div>
                </div>
                <div class="request-card__footer">

                    <a href="expert-request-details.html" class="btn btn--outline-primary btn--sm btn--block">
                        مشاهده و پیشنهاد
                    </a>
                </div>
            </div>

            <!-- Request Card 2 -->
            <div class="request-card">
                <div class="request-card__header">
                    <div class="request-card__service-badge">
                        تهویه مطبوع
                    </div>
                    <span class="request-card__date">۱۴۰۴/۱۰/۰۸</span>
                </div>

                <div class="request-card__body">
                    <h4 class="request-card__title">نصب کولر گازی ۲۴۰۰۰ جنرال</h4>
                    <p class="request-card__desc">
                        نصب کولر گازی اسپلیت جنرال در طبقه سوم آپارتمان. لوله‌کشی مسی انجام شده
                        است.
                    </p>
                    <div class="request-card__price">
                        <div class="request-card__suggested-date">
                            <span class="text-muted">تاریخ پیشنهادی:</span>
                            <span>۱۴۰۴/۱۰/۱۱</span>
                        </div>
                        <span class="price-value">۸۰۰٬۰۰۰ تومان</span>
                    </div>
                </div>

                <div class="request-card__footer">
                    <a href="expert-request-details.html" class="btn btn--outline-primary btn--sm btn--block">
                        مشاهده و پیشنهاد
                    </a>
                </div>
            </div>

            <!-- Request Card 3 -->
            <div class="request-card">
                <div class="request-card__header">
                    <div class="request-card__service-badge">
                        لوله‌کشی
                    </div>
                    <span class="request-card__date">۱۴۰۴/۱۰/۰۷</span>
                </div>

                <div class="request-card__body">
                    <h4 class="request-card__title">رفع نشتی لوله آب گرم آشپزخانه</h4>
                    <p class="request-card__desc">
                        لوله آب گرم زیر سینک آشپزخانه نشتی دارد. نیاز به رفع نشتی و تعویض اتصالات.
                    </p>
                    <div class="request-card__price">
                        <div class="request-card__suggested-date">
                            <span class="text-muted">تاریخ پیشنهادی:</span>
                            <span>۱۴۰۴/۱۰/۱۰</span>
                        </div>
                        <span class="price-value">۳۰۰٬۰۰۰ تومان</span>
                    </div>
                </div>

                <div class="request-card__footer">
                    <a href="expert-request-details.html" class="btn btn--outline-primary btn--sm btn--block">
                        مشاهده و پیشنهاد
                    </a>
                </div>
            </div>

            <!-- Request Card 4 -->
            <div class="request-card">
                <div class="request-card__header">
                    <div class="request-card__service-badge">
                        برق‌کاری
                    </div>
                    <span class="request-card__date">۱۴۰۴/۱۰/۰۶</span>
                </div>

                <div class="request-card__body">
                    <h4 class="request-card__title">سیم‌کشی کامل واحد مسکونی</h4>
                    <p class="request-card__desc">سیم‌کشی کامل آپارتمان ۱۰۰ متری نوساز با ۳ اتاق خواب و پذیرایی بزرگ.</p>
                    <div class="request-card__price">
                        <div class="request-card__suggested-date">
                            <span class="text-muted">تاریخ پیشنهادی:</span>
                            <span>۱۴۰۴/۱۰/۰۹</span>
                        </div>
                        <span class="price-value">۲٬۵۰۰٬۰۰۰ تومان</span>
                    </div>
                </div>

                <div class="request-card__footer">
                    <a href="expert-request-details.html" class="btn btn--outline-primary btn--sm btn--block">
                        مشاهده و پیشنهاد
                    </a>
                </div>
            </div>

            <!-- Request Card 5 -->
            <div class="request-card">
                <div class="request-card__header">
                    <div class="request-card__service-badge">
                        لوازم خانگی
                    </div>
                    <span class="request-card__date">۱۴۰۴/۱۰/۰۵</span>
                </div>

                <div class="request-card__body">
                    <h4 class="request-card__title">تعمیر ماشین لباسشویی سامسونگ</h4>
                    <p class="request-card__desc">لباسشویی صدای زیادی می‌دهد و آب را تخلیه نمی‌کند. مدل J1477.</p>
                    <div class="request-card__price">
                        <div class="request-card__suggested-date">
                            <span class="text-muted">تاریخ پیشنهادی:</span>
                            <span>۱۴۰۴/۱۰/۰۸</span>
                        </div>
                        <span class="price-value">۴۵۰٬۰۰۰ تومان</span>
                    </div>
                </div>

                <div class="request-card__footer">
                    <a href="expert-request-details.html" class="btn btn--outline-primary btn--sm btn--block">
                        مشاهده و پیشنهاد
                    </a>
                </div>
            </div>

            <!-- Request Card 6 -->
            <div class="request-card">
                <div class="request-card__header">
                    <div class="request-card__service-badge">
                        لوله‌کشی
                    </div>
                    <span class="request-card__date">۱۴۰۴/۱۰/۰۴</span>
                </div>

                <div class="request-card__body">
                    <h4 class="request-card__title">تعویض شیر آب حمام و توالت</h4>
                    <p class="request-card__desc">شیر آب حمام نشتی دارد و نیاز به تعویض است. شیر توالت هم چکه می‌کند.</p>
                    <div class="request-card__price">
                        <div class="request-card__suggested-date">
                            <span class="text-muted">تاریخ پیشنهادی:</span>
                            <span>۱۴۰۴/۱۰/۰۷</span>
                        </div>
                        <span class="price-value">۲۰۰٬۰۰۰ تومان</span>
                    </div>
                </div>

                <div class="request-card__footer">
                    <a href="expert-request-details.html" class="btn btn--outline-primary btn--sm btn--block">
                        مشاهده و پیشنهاد
                    </a>
                </div>
            </div>
        </div>

        <!-- Pagination -->
        <nav class="user-pagination" aria-label="صفحه‌بندی">
            <a href="#" class="user-pagination__btn" aria-label="صفحه قبل">قبلی</a>
            <div class="user-pagination__pages">
                <a href="#" class="user-pagination__page is-active">۱</a>
                <a href="#" class="user-pagination__page">۲</a>
                <a href="#" class="user-pagination__page">۳</a>
            </div>
            <a href="#" class="user-pagination__btn" aria-label="صفحه بعد">بعدی</a>
        </nav>
    </div>
</section>