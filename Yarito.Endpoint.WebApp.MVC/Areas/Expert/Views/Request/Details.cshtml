@{
    Layout = "_Layout";
}
<section class="profile-main">

    <!-- Section 1: Request Info + Images -->
    <section class="card user-section">
        <div class="user-section__header">
            <h3>اطلاعات درخواست</h3>
            <span class="badge badge--receiving">در حال دریافت پیشنهاد</span>
        </div>

        <div class="user-request-combined">
            <!-- Request Info -->
            <div class="user-request-info">
                <div class="user-info-grid">
                    <div class="user-info-item">
                        <dt>عنوان درخواست</dt>
                        <dd>تعمیر پکیج دیواری ایران رادیاتور</dd>
                    </div>
                    <div class="user-info-item">
                        <dt>سرویس</dt>
                        <dd>تهویه مطبوع</dd>
                    </div>
                    <div class="user-info-item">
                        <dt>تاریخ ثبت</dt>
                        <dd>۱۴۰۴/۱۰/۰۹</dd>
                    </div>
                    <div class="user-info-item">
                        <dt>تاریخ مراجعه درخواستی</dt>
                        <dd>۱۴۰۴/۱۰/۱۵</dd>
                    </div>
                    <div class="user-info-item">
                        <dt>قیمت پیشنهادی مشتری</dt>
                        <dd><strong class="text-primary">۵۰۰٬۰۰۰ تومان</strong></dd>
                    </div>
                    <div class="user-info-item">
                        <dt>آدرس</dt>
                        <dd>تهران، خیابان آزادی، کوچه بهار، پلاک ۱۲، واحد ۳</dd>
                    </div>
                    <div class="user-info-item user-info-item--full">
                        <dt>توضیحات</dt>
                        <dd>
                            پکیج دیواری ایران رادیاتور مدل M24 خطای E۱۰ می‌دهد و آب گرم نمی‌کند. قبلاً یکبار سرویس شده اما
                            مشکل برطرف نشده. نیاز به بررسی کامل و تعمیر دارد. در صورت نیاز به تعویض قطعه، هماهنگ شود.
                        </dd>
                    </div>
                </div>
            </div>

            <!-- Uploaded Images -->
            <div class="user-request-images">
                <div class="user-images-grid user-images-grid--4">
                    <div class="user-image-item">
                        <img src="../images.jpg" alt="تصویر آپلود شده">
                    </div>
                    <div class="user-image-item">
                        <img src="../images.jpg" alt="تصویر آپلود شده">
                    </div>
                    <div class="user-image-item">
                        <img src="../images.jpg" alt="تصویر آپلود شده">
                    </div>
                    <div class="user-image-item">
                        <img src="../images.jpg" alt="تصویر آپلود شده">
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Two Column Layout: Customer Info (Right) + Proposal (Left) -->
    <div class="two-column-layout">
        <!-- Right Column: Customer Info with Profile Image -->
        <section class="card user-section customer-profile-card">
            <div class="user-section__header">
                <h3>اطلاعات مشتری</h3>
            </div>

            <div class="customer-profile-header">
                <img class="customer-profile-avatar" src="../default.png" alt="تصویر مشتری">
                <div class="customer-profile-info">
                    <h4 class="customer-profile-name">محمد احمدی</h4>
                    <div class="customer-profile-phone">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z">
                            </path>
                        </svg>
                        <span dir="ltr">۰۹۱۲۳۴۵۶۷۸۹</span>
                    </div>
                </div>
            </div>

            <dl class="customer-profile-details">
                <div class="customer-detail-row">
                    <dt>آدرس:</dt>
                    <dd>تهران، خیابان آزادی، کوچه بهار، پلاک ۱۲، طبقه ۳، واحد غربی</dd>
                </div>
            </dl>
        </section>

        <!-- Left Column: Expert's Proposal -->
        <section class="card user-section">
            <div class="user-section__header">
                <h3>پیشنهاد شما</h3>
                <span class="badge badge--pending">در انتظار بررسی</span>
            </div>

            <div class="user-info-grid">
                <div class="user-info-item">
                    <dt>قیمت پیشنهادی</dt>
                    <dd><strong class="text-primary">۵۵۰٬۰۰۰ تومان</strong></dd>
                </div>
                <div class="user-info-item">
                    <dt>تاریخ مراجعه پیشنهادی</dt>
                    <dd>۱۴۰۴/۱۰/۱۴</dd>
                </div>
                <div class="user-info-item">
                    <dt>تاریخ ثبت پیشنهاد</dt>
                    <dd>۱۴۰۴/۱۰/۰۹</dd>
                </div>
                <div class="user-info-item user-info-item--full">
                    <dt>توضیحات پیشنهاد</dt>
                    <dd>
                        با توجه به تجربه ۸ ساله در تعمیر انواع پکیج، می‌توانم مشکل را بررسی و برطرف کنم. در صورت نیاز به
                        تعویض قطعه، هزینه جداگانه محاسبه خواهد شد.
                    </dd>
                </div>
            </div>

            <div class="user-section__actions">
                <a href="expert-requests.html" class="btn btn--ghost btn--sm">بازگشت به لیست</a>
            </div>
        </section>
    </div>

