@using Yarito.Endpoint.WebApp.MVC.Areas.Expert.Models
@model Yarito.Endpoint.WebApp.MVC.Areas.Expert.Models.DashboardViewModel

@{
    Layout = "_Layout";
}

<section class="profile-main">
    <!-- Profile Incomplete Alert -->
    @if (!Model.UserInfo.IsInfoComplete)
    {
        <div class="profile-alert">
            <div class="profile-alert__icon">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
            </div>
            <div class="profile-alert__content">
                <h4 class="profile-alert__title">اطلاعات پروفایل شما کامل نیست!</h4>
                <p class="profile-alert__text">برای ثبت پیشنهاد جدید، لطفاً اطلاعات پروفایل خود را تکمیل کنید.</p>
            </div>
            <div class="profile-alert__action">
                <a asp-area="Expert"
                   asp-controller="Profile"
                   asp-action="Form"
                   class="btn btn--sm">تکمیل پروفایل</a>
            </div>
        </div>
    }

    <!-- Services Card -->
    <div class="card dashboard-card dashboard-card--services">
        <div class="dashboard-card__header-inline">
            <h3 class="dashboard-card__title">خدمات من</h3>
        </div>
        @if (Model.ExpertWorks.Count == 0)
        {
            <p class="muted">شما هنوز هیچ خدمتی ثبت نکرده‌اید.</p>
        }
        else
        {
            <div class="service-chips">
                @foreach (var c in Model.ExpertWorks)
                {
                    <span>@c.CategoryTitle</span>
                    @foreach (var w in c.Works)
                    {
                        <span class="service-chip">@w.Title</span>
                    }
                }
            </div>
        }
    </div>

    <!-- Top 3 Cards Row -->
    <div class="dashboard-cards-row">
        <!-- Balance Card -->
        <div class="card dashboard-card">
            <h3 class="dashboard-card__title">موجودی حساب</h3>
            <p class="dashboard-card__amount">@Model.UserInfo.WalletBalance.ToString("N0").ToPersianNum() <span class="dashboard-card__currency">تومان</span></p>
            <a href="#" class="btn btn--primary btn--sm">برداشت</a>
        </div>

        <!-- Available Requests Card -->
        <div class="card dashboard-card">
            <h3 class="dashboard-card__title">درخواست‌های موجود</h3>
            <p class="dashboard-card__desc muted">مشاهده درخواست‌های جدید</p>
            <a href="#" class="btn btn--primary btn--sm">مشاهده لیست</a>
        </div>

        <!-- Offer History Card -->
        <div class="card dashboard-card">
            <h3 class="dashboard-card__title">تاریخچه پیشنهادات</h3>
            <p class="dashboard-card__desc muted">مشاهده پیشنهادات قبلی</p>
            <a href="#" class="btn btn--secondary btn--sm">مشاهده</a>
        </div>
    </div>

    <!-- Today's Visits Full Width -->
    <div class="dashboard-cards-row dashboard-cards-row--full">
        <div class="card dashboard-card dashboard-card--list">
            <div class="dashboard-card__header-inline">
                <h3 class="dashboard-card__title">مراجعه‌های امروز <span class="offers-count">(@Model.TotalCount.ToString().ToPersianNum() مراجعه)</span></h3>
                <a href="#" class="btn-link">مشاهده همه</a>
            </div>
            <div class="visit-list visit-list--grid">
                @if (Model.TodayVisits.Count == 0)
                {
                    <h3 class="dashboard-card__title">‌<span class="offers-count">امروز هیچ مراجعه ای ندارید</span></h3>
                }
                else
                {
                    @foreach (var v in Model.TodayVisits)
                    {
                        <div class="visit-item">
                            <div class="visit-item__main">
                                <span class="visit-item__title">@v.Title</span>
                                <div class="visit-item__details">
                                    <div class="visit-item__detail">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                            <circle cx="12" cy="7" r="4"></circle>
                                        </svg>
                                        <span>@v.FirstName @v.LastName</span>
                                    </div>
                                    <div class="visit-item__detail">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l2.18-2.18a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7 2 2 0 0 1 1.71 1.96z"></path>
                                        </svg>
                                        <span dir="ltr">@v.CustomerPhoneNumber.ToPersianNum()</span>
                                    </div>
                                </div>
                            </div>
                            <a href="#" class="btn btn--ghost btn--sm">نمایش جزئیات</a>
                        </div>
                    }
                }
            </div>
            <!-- Pagination -->
            @await Html.PartialAsync("_Pagination", new PaginationViewModel
            {
                Page = Model.Page,
                TotalPages = Model.TotalPages,
                Area = "Expert",
                Controller = "Dashboard",
                Action = "Index",
                RouteValues = new Dictionary<string, string?>()
            })
        </div>
    </div>
</section>